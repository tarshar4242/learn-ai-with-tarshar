---
import '@fontsource-variable/noto-serif-tc';
import '@fontsource-variable/noto-sans-tc';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import content from '../data/content.json';
import '../styles/tokens.css';

const { title, description, page, noindex } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} | Learn AI with Tarshar` : 'Learn AI with Tarshar';
const audiencesJson = JSON.stringify(content.audiences).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Learn AI with Tarshar" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={new URL(`${base}images/hero-illustration.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="shell">
      <Sidebar page={page} />
      <div class="main-wrap">
        <main>
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    {page !== 'admin' && (
      <a href={`${base}admin/`} class="admin-fab" aria-label="開啟內容後台">⚙ 後台</a>
    )}

    <script is:inline set:html={`window.__AUDIENCES__ = ${audiencesJson}; window.__BASE_URL__ = ${JSON.stringify(base)};`} />
    <script>
      import '../scripts/reveal.js';
      import '../scripts/audience.js';
    </script>
  </body>
</html>

<style is:global>
  /* 分眾權限保護：元件自己的 display:flex/grid/block 設定，
     在 CSS 優先權上會蓋掉瀏覽器對 [hidden] 的預設隱藏行為，
     導致設了「誰看得到」限定的內容還是對所有人顯示。
     這條規則用 !important 確保 hidden 一定贏，不管元件自己怎麼設 display。 */
  [hidden] { display: none !important; }

  .shell {
    display: flex;
    min-height: 100vh;
    background: var(--c-bg);
  }
  .main-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  main { flex: 1; }

  .admin-fab {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 70;
    padding: 12px 20px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(31, 107, 69, .16);
    background: rgba(255, 255, 255, .96);
    color: var(--c-brand);
    font-size: var(--fs-15);
    box-shadow: 0 10px 28px rgba(31, 107, 69, .18);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .admin-fab:hover { color: var(--c-brand); transform: translateY(-2px); }
  @media (max-width: 900px) {
    .admin-fab { right: 14px; bottom: 14px; padding: 10px 16px; font-size: var(--fs-13); }
  }
</style>
