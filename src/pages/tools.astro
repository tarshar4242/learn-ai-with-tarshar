---
import Layout from '../layouts/Layout.astro';
import content from '../data/content.json';

const { text, tools, audiences } = content;

function audName(id) {
  const a = audiences.find((x) => x.id === id);
  return a ? a.name : id;
}
---

<Layout page="tools" title="工具集" description={text.toolsLead}>
  <section class="page-section">
    <div class="head" data-reveal="1">
      <div class="eyebrow">TOOLKIT</div>
      <h1 class="page-title">工具集</h1>
      <p class="lead">{text.toolsLead}</p>
    </div>

    <div class="grid">
      {tools.map((w) => {
        const restricted = w.aud.length > 0;
        const badgeLabel = restricted ? '限 ' + w.aud.map(audName).join('・') : '';
        const hasUrl = w.url && w.url.trim().length > 0;
        return (
          <a
            href={hasUrl ? w.url : '#'}
            target={hasUrl ? '_blank' : undefined}
            rel={hasUrl ? 'noopener' : undefined}
            class="tool-card"
            data-reveal="1"
            data-aud={restricted ? w.aud.join(',') : undefined}
            hidden={restricted}
          >
            <span class="tag-row">
              <span class="tag">{w.tag}</span>
              {restricted && <span class="badge">{badgeLabel}</span>}
            </span>
            <span class="name">{w.name}</span>
            <span class="desc">{w.desc}</span>
            <span class="link-label">{hasUrl ? '開啟工具 ›' : '即將開放'}</span>
          </a>
        );
      })}
    </div>
  </section>
</Layout>

<style>
  .page-section {
    width: 88%;
    max-width: 1000px;
    margin: 0 auto;
    padding: 64px var(--space-h) 80px;
  }
  .head { margin-bottom: 36px; }
  .eyebrow {
    font-size: var(--fs-13);
    letter-spacing: .22em;
    color: var(--c-accent);
    margin-bottom: 14px;
  }
  .page-title {
    font-family: var(--font-head);
    font-size: var(--fs-page-title);
    margin: 0 0 14px;
  }
  .lead {
    font-size: var(--fs-17);
    line-height: 2;
    color: var(--c-body);
    margin: 0;
    max-width: 38em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    box-shadow: 0 2px 10px var(--c-shadow);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .tool-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 34px var(--c-shadow-strong);
  }
  .tag-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .tag {
    font-size: var(--fs-12);
    padding: 4px 11px;
    border-radius: var(--radius-pill);
    background: var(--c-accent-chip-bg);
    color: var(--c-brand-hover);
  }
  .badge {
    font-size: var(--fs-12);
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: var(--c-accent-chip-bg-strong);
    color: var(--c-body-soft);
    white-space: nowrap;
  }
  .name { font-family: var(--font-head); font-size: var(--fs-21); color: var(--c-ink); }
  .desc { font-size: var(--fs-15); line-height: 1.9; color: var(--c-body-soft); }
  .link-label { font-size: var(--fs-15); color: var(--c-brand); margin-top: auto; padding-top: 6px; }
</style>
