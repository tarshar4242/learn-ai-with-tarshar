---
import Layout from '../layouts/Layout.astro';
import content from '../data/content.json';

const { text, posts, audiences } = content;
const publicCount = posts.filter((p) => p.aud.length === 0).length;

function audName(id) {
  const a = audiences.find((x) => x.id === id);
  return a ? a.name : id;
}
---

<Layout page="blog" title="部落格文章" description={text.newsletterDesc}>
  <section class="page-section">
    <div class="head" data-reveal="1">
      <div class="eyebrow">JOURNAL</div>
      <h1 class="page-title">部落格文章</h1>
      <p class="lead">你目前看得到 {publicCount} 篇。點標題可以連到文章原文。</p>
    </div>

    <div class="posts">
      {posts.map((p) => {
        const restricted = p.aud.length > 0;
        const badgeLabel = restricted ? '限 ' + p.aud.map(audName).join('・') : '';
        return (
          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class="post-card"
            data-reveal="1"
            data-aud={restricted ? p.aud.join(',') : undefined}
            hidden={restricted}
          >
            <div class="meta-row">
              <span class="date">{p.date}</span>
              <span class="tag">{p.tag}</span>
              {restricted && <span class="badge">{badgeLabel}</span>}
            </div>
            <div class="title">{p.title}</div>
            <div class="summary">{p.summary}</div>
          </a>
        );
      })}
    </div>
  </section>
</Layout>

<style>
  .page-section {
    width: 88%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 64px var(--space-h) 80px;
  }
  .head { margin-bottom: 36px; }
  .eyebrow {
    font-size: var(--fs-13);
    letter-spacing: .22em;
    color: var(--c-accent);
    margin-bottom: 14px;
  }
  .page-title {
    font-family: var(--font-head);
    font-size: var(--fs-page-title);
    margin: 0 0 14px;
  }
  .lead { font-size: var(--fs-17); line-height: 2; color: var(--c-body); margin: 0; }

  .posts { display: grid; gap: 14px; }
  .post-card {
    display: block;
    padding: 24px 26px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    box-shadow: 0 2px 10px var(--c-shadow);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px var(--c-shadow-strong);
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .date { font-size: var(--fs-13); color: var(--c-faintest); }
  .tag {
    font-size: var(--fs-12);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--c-accent-chip-bg);
    color: var(--c-brand-hover);
  }
  .badge {
    font-size: var(--fs-12);
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: var(--c-accent-chip-bg-strong);
    color: var(--c-body-soft);
    white-space: nowrap;
  }
  .title {
    font-family: var(--font-head);
    font-size: var(--fs-21);
    color: var(--c-ink);
    line-height: 1.6;
  }
  .summary {
    font-size: var(--fs-15);
    line-height: 1.9;
    color: var(--c-muted);
    margin-top: 10px;
  }
</style>
