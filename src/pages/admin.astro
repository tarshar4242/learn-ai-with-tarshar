---
import Layout from '../layouts/Layout.astro';
import content from '../data/content.json';

const contentJson = JSON.stringify(content).replace(/</g, '\\u003c');
---

<Layout page="admin" title="內容後台" noindex={true}>
  <section class="admin-page">
    <div class="admin-head">
      <h1>內容後台</h1>
      <p>改文字、系列、文章、工具、觀眾群這些內容都在這裡。改完按「下載 content.json」，
      再把下載的檔案上傳到 GitHub 蓋掉 <code>src/data/content.json</code> 就會正式生效。</p>
      <div class="draft-banner" id="draft-banner" hidden>
        <span id="draft-banner-text"></span>
        <div class="draft-actions">
          <button type="button" id="use-draft-btn">改用我的本機草稿</button>
          <button type="button" id="discard-draft-btn">丟掉草稿，用檔案內容</button>
        </div>
      </div>
    </div>

    <nav class="tabs" id="admin-tabs"></nav>
    <div class="panel" id="admin-panel"></div>

    <div class="admin-foot">
      <button type="button" id="download-btn" class="primary">下載 content.json（存檔）</button>
      <button type="button" id="reset-btn">還原成檔案裡的內容</button>
      <span class="save-hint" id="save-hint"></span>
    </div>
  </section>
</Layout>

<script type="application/json" id="content-baseline" set:html={contentJson} />

<script>
  import '../scripts/admin.js';
</script>

<style is:global>
  .admin-page {
    width: 88%;
    max-width: 900px;
    margin: 0 auto;
    padding: 56px var(--space-h) 100px;
  }
  .admin-head h1 {
    font-family: var(--font-head);
    font-size: var(--fs-32);
    margin: 0 0 12px;
  }
  .admin-head p {
    font-size: var(--fs-15);
    line-height: 1.9;
    color: var(--c-body-soft);
    margin: 0 0 20px;
  }
  .admin-head code {
    background: var(--c-bg-soft);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: .9em;
  }

  .draft-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 14px 18px;
    border-radius: var(--radius-md);
    background: var(--c-warn-bg);
    color: var(--c-warn-text);
    font-size: var(--fs-13);
    margin-bottom: 24px;
  }
  .draft-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .draft-actions button {
    border: 1px solid rgba(138, 98, 32, .3);
    background: #fff;
    color: var(--c-warn-text);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--c-border);
  }
  .tabs button {
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-border-form);
    background: #fff;
    color: var(--c-body-soft);
    font-family: inherit;
    font-size: var(--fs-13);
    cursor: pointer;
  }
  .tabs button.active {
    background: var(--c-brand);
    border-color: var(--c-brand);
    color: #fff;
  }

  .panel { display: grid; gap: 20px; }

  .field-group {
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
  }
  .field-group label {
    font-size: var(--fs-13);
    color: var(--c-body-soft);
    font-weight: 600;
  }
  .field-group input,
  .field-group textarea {
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--c-border-form);
    font-family: inherit;
    font-size: var(--fs-15);
    background: var(--c-bg-form);
    outline: none;
  }

  .item-card {
    padding: 20px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    display: grid;
    gap: 12px;
  }
  .item-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .item-card-head .idx { font-size: var(--fs-13); color: var(--c-faintest); }
  .item-actions { display: flex; gap: 6px; }
  .item-actions button {
    border: none;
    background: var(--c-accent-chip-bg-strong);
    width: 28px;
    height: 28px;
    border-radius: 7px;
    cursor: pointer;
    color: var(--c-body-soft);
    font-size: 13px;
  }
  .item-actions button.danger { color: var(--c-brand); }

  .aud-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding-top: 8px;
    border-top: 1px dashed var(--c-border);
  }
  .aud-chip {
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-border-form);
    background: #fff;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
    color: var(--c-body-soft);
  }
  .aud-chip.on {
    background: var(--c-brand);
    border-color: var(--c-brand);
    color: #fff;
  }

  .add-btn {
    padding: 12px;
    border-radius: 12px;
    border: 1px dashed rgba(31, 107, 69, .32);
    background: rgba(31, 107, 69, .04);
    font-family: inherit;
    font-size: var(--fs-15);
    color: var(--c-brand);
    cursor: pointer;
  }

  .bulk-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    padding: 12px 14px;
    background: var(--c-bg-soft);
    border-radius: var(--radius-md);
    margin-bottom: 4px;
  }
  .bulk-row span { font-size: 12px; color: var(--c-faintest); }
  .bulk-row button {
    padding: 7px 12px;
    border-radius: 10px;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .bulk-row .bulk-apply-all { border: none; background: var(--c-brand); color: #fff; }
  .bulk-row .bulk-public { border: 1px solid var(--c-border-form); background: transparent; color: var(--c-faint); }

  .audience-card {
    display: grid;
    gap: 10px;
    padding: 16px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
  }
  .audience-share {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--c-faintest);
  }
  .audience-share code {
    background: var(--c-bg-soft);
    padding: 4px 8px;
    border-radius: 6px;
    word-break: break-all;
  }
  .audience-share button {
    border: none;
    background: var(--c-brand);
    color: #fff;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
  }

  .admin-foot {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--c-border);
  }
  .admin-foot button.primary {
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--c-brand);
    color: #fff;
    font-family: inherit;
    font-size: var(--fs-15);
    cursor: pointer;
  }
  .admin-foot button:not(.primary) {
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-border-form);
    background: transparent;
    font-family: inherit;
    font-size: var(--fs-13);
    color: var(--c-faint);
    cursor: pointer;
  }
  .save-hint { font-size: 12px; color: var(--c-brand-hover); }
</style>
