---
import content from '../data/content.json';

const { series, reveal = true } = Astro.props;
const audiences = content.audiences;

function audName(id) {
  const a = audiences.find((x) => x.id === id);
  return a ? a.name : id;
}
const restricted = series.aud && series.aud.length > 0;
const badgeLabel = restricted ? '限 ' + series.aud.map(audName).join('・') : '';
---

<div
  class="series-card"
  data-reveal={reveal ? '1' : undefined}
  data-aud={restricted ? series.aud.join(',') : undefined}
  hidden={restricted}
>
  <div class="top" style={`background:${series.accent}`}></div>
  <div class="body">
    <div class="head-row">
      <span class="code">{series.code}</span>
      {restricted && <span class="badge">{badgeLabel}</span>}
    </div>
    <div class="title">{series.title}</div>
    <div class="desc">{series.desc}</div>
    <div class="foot">
      <span class="count-pill">{series.count}</span>
      <a href={series.url} target="_blank" rel="noopener">進入系列 ›</a>
    </div>
  </div>
</div>

<style>
  .series-card {
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 2px 10px var(--c-shadow);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .series-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 34px var(--c-shadow-strong);
  }
  .top { height: 5px; }
  .body { padding: 24px; }
  .head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }
  .code {
    font-size: var(--fs-12);
    letter-spacing: .18em;
    color: var(--c-faintest);
  }
  .badge {
    font-size: var(--fs-12);
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: var(--c-accent-chip-bg-strong);
    color: var(--c-body-soft);
    white-space: nowrap;
  }
  .title {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-21);
    color: var(--c-ink-strong);
    letter-spacing: .01em;
    margin-bottom: 12px;
  }
  .desc {
    font-size: var(--fs-15);
    line-height: 1.9;
    color: var(--c-body-soft);
    min-height: 5.7em;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
  }
  .count-pill {
    font-size: var(--fs-13);
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--c-accent-chip-bg);
    color: var(--c-brand-hover);
  }
  .foot a { font-size: var(--fs-15); }
</style>
