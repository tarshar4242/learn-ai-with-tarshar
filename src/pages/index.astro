---
import Layout from '../layouts/Layout.astro';
import SeriesCard from '../components/SeriesCard.astro';
import PostRow from '../components/PostRow.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import content from '../data/content.json';

const base = import.meta.env.BASE_URL;
const { text, stats, series, pillars, posts } = content;
const featuredSeries = series.slice(0, 3);
const recentPosts = posts.slice(0, 4);
---

<Layout page="home" title="首頁" description={text.heroLead}>

  <!-- Hero -->
  <section class="hero-section">
    <div class="hero-inner">
      <div class="hero-text" data-reveal="1">
        <div class="badge">{text.badge}</div>
        <h1 class="hero-title">
          {text.heroTitle}<br />
          <span class="accent">{text.heroTitleAccent}</span>
        </h1>
        <p class="hero-lead">{text.heroLead}</p>
        <div class="cta-row">
          <a href={`${base}courses/`} class="cta-primary">{text.ctaPrimary}</a>
          <a href={`${base}contact/`} class="cta-secondary">{text.ctaSecondary}</a>
        </div>
        <div class="stats-row">
          {stats.map((s) => (
            <div class="stat" data-aud={s.aud.length ? s.aud.join(',') : undefined} hidden={s.aud.length > 0}>
              <div class="stat-value">{s.value}</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
      <div class="hero-figure" data-reveal="1">
        <div class="hero-glow"></div>
        <img src={`${base}images/hero-illustration.png`} alt="Tarshar 與 AI 一起工作的插畫" />
      </div>
    </div>
  </section>

  <!-- About 摘要 -->
  <section class="about-section">
    <div class="about-inner" data-reveal="1">
      <div>
        <div class="eyebrow">ABOUT</div>
        <h2 class="section-title">我是誰</h2>
        <p class="about-p">{text.aboutP1}</p>
        <p class="about-p">{text.aboutP2}</p>
        <a href={`${base}about/`} class="more-link">更多關於我 →</a>
      </div>
      <div class="pillars">
        {pillars.map((p) => (
          <div class="pillar-card">
            <div class="pillar-title">{p.title}</div>
            <div class="pillar-desc">{p.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 課程系列 -->
  <section class="series-section">
    <div class="series-inner">
      <div class="series-head" data-reveal="1">
        <div>
          <div class="eyebrow">SERIES</div>
          <h2 class="section-title" style="margin:0;">課程系列</h2>
        </div>
        <a href={`${base}courses/`}>看全部系列 →</a>
      </div>
      <div class="series-grid">
        {featuredSeries.map((s) => <SeriesCard series={s} />)}
      </div>
    </div>
  </section>

  <!-- 最新文章 + 電子報 -->
  <section class="journal-section">
    <div class="journal-inner" data-reveal="1">
      <div>
        <div class="eyebrow">JOURNAL</div>
        <h2 class="section-title">最新文章</h2>
        <div class="posts-list">
          {recentPosts.map((p) => <PostRow post={p} />)}
        </div>
        <a href={`${base}blog/`} class="more-link block">看全部文章 →</a>
      </div>
      <div>
        <NewsletterBox />
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero-section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--space-h);
  }
  .hero-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
    padding: var(--space-section-desktop) 0 60px;
  }
  .hero-text { flex: 1 1 330px; min-width: 0; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--c-accent-chip-bg-strong);
    color: var(--c-brand-hover);
    font-size: var(--fs-13);
    letter-spacing: .08em;
    margin-bottom: 24px;
  }
  .hero-title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--fs-hero);
    line-height: 1.25;
    margin: 0 0 22px;
  }
  .hero-title .accent { color: var(--c-brand); }
  .hero-lead {
    font-size: var(--fs-17);
    line-height: 1.95;
    color: var(--c-body);
    max-width: 30em;
    margin: 0 0 32px;
  }
  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; }
  .cta-primary {
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    background: var(--c-brand);
    color: #fff;
    font-size: var(--fs-17);
    font-weight: 500;
    white-space: nowrap;
    box-shadow: 0 8px 20px rgba(31, 107, 69, .22);
    transition: transform .2s ease;
  }
  .cta-primary:hover { transform: translateY(-2px); color: #fff; }
  .cta-secondary {
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(31, 107, 69, .26);
    font-size: var(--fs-17);
    white-space: nowrap;
    transition: background .2s ease;
  }
  .cta-secondary:hover { background: rgba(124, 191, 106, .14); }
  .stats-row { display: flex; gap: 40px; margin-top: 48px; flex-wrap: wrap; }
  .stat-value {
    font-family: var(--font-head);
    font-size: var(--fs-32);
    color: var(--c-brand);
    line-height: 1;
  }
  .stat-label {
    font-size: var(--fs-13);
    color: var(--c-muted);
    margin-top: 8px;
    letter-spacing: .04em;
  }
  .hero-figure {
    position: relative;
    flex: 1.32 1 380px;
    min-width: 0;
  }
  .hero-glow {
    position: absolute;
    inset: -12%;
    background: radial-gradient(60% 60% at 60% 40%, rgba(124, 191, 106, .26), rgba(124, 191, 106, 0) 70%);
  }
  .hero-figure img {
    position: relative;
    width: 100%;
    border-radius: 24px;
    box-shadow: 0 24px 56px rgba(31, 107, 69, .15);
  }

  .about-section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 56px var(--space-h) 64px;
  }
  .about-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 52px;
    align-items: start;
  }
  .eyebrow {
    font-size: var(--fs-13);
    letter-spacing: .22em;
    color: var(--c-accent);
    margin-bottom: 14px;
  }
  .section-title {
    font-family: var(--font-head);
    font-size: var(--fs-32);
    margin: 0 0 20px;
    line-height: 1.4;
  }
  .about-p {
    font-size: var(--fs-17);
    line-height: 2;
    color: var(--c-body);
    margin: 0 0 16px;
  }
  .more-link {
    font-size: var(--fs-15);
    border-bottom: 1px solid rgba(31, 107, 69, .35);
    padding-bottom: 2px;
  }
  .more-link.block { display: inline-block; margin-top: 20px; border-bottom: none; }
  .pillars { display: grid; gap: 16px; }
  .pillar-card {
    padding: 22px 24px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    box-shadow: 0 2px 10px var(--c-shadow);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .pillar-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 26px rgba(31, 107, 69, .10);
  }
  .pillar-title {
    font-size: var(--fs-17);
    font-weight: 700;
    color: var(--c-brand);
    margin-bottom: 8px;
  }
  .pillar-desc { font-size: var(--fs-15); line-height: 1.85; color: var(--c-body-soft); }

  .series-section {
    background: linear-gradient(180deg, rgba(237, 245, 236, .72), rgba(250, 249, 243, 0));
  }
  .series-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 64px var(--space-h);
  }
  .series-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
  }

  .journal-section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 52px var(--space-h) 80px;
  }
  .journal-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 44px;
  }
  .posts-list { display: grid; }

  @media (max-width: 880px) {
    .hero-inner { padding-top: var(--space-section-mobile); }
  }
</style>
