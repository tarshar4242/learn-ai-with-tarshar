---
import { NAV_ITEMS } from '../lib/nav.js';
import content from '../data/content.json';

const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="inner">
    <img class="ink-logo" src={`${base}images/logo-ink.png`} alt="荏眉印 ・ Learn AI with Tarshar" />

    <div class="columns">
      <div class="col">
        <div class="col-label">SITE</div>
        {NAV_ITEMS.map((item) => (
          <a href={`${base}${item.href}`}>{item.label}</a>
        ))}
      </div>
      <div class="col">
        <div class="col-label">CONTACT</div>
        <div class="contact-text">{content.text.email}<br />{content.text.location}</div>
      </div>
      <div class="col">
        <div class="col-label">NOTES</div>
        <a href={`${base}courses/`}>課程筆記館</a>
        <a href={`${base}tools/`}>工具集</a>
      </div>
    </div>

    <div class="copyright">© 2026 Learn AI with Tarshar. 一起輕輕鬆鬆學 AI。</div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-border-strong);
    background: linear-gradient(180deg, rgba(237, 245, 236, .35), rgba(237, 245, 236, .75));
  }
  .inner {
    width: 88%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 56px var(--space-h) 40px;
  }
  .ink-logo {
    width: 100%;
    max-width: 720px;
    margin: 0 auto 40px;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
    align-items: start;
    padding-top: 32px;
    border-top: 1px solid var(--c-border-form);
  }
  .col { display: grid; gap: 10px; }
  .col-label {
    font-size: var(--fs-12);
    letter-spacing: .18em;
    color: var(--c-accent);
    margin-bottom: 2px;
  }
  .col a {
    font-size: var(--fs-15);
    color: var(--c-body-soft);
  }
  .col a:hover { color: var(--c-brand); }
  .contact-text {
    font-size: var(--fs-15);
    color: var(--c-body-soft);
    line-height: 1.9;
  }
  .copyright {
    margin-top: 32px;
    font-size: var(--fs-13);
    color: var(--c-lightest);
  }
</style>
